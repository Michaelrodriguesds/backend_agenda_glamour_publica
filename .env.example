# ── Banco de dados (MongoDB Atlas) ───────────────────────────────
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/belaagenda?retryWrites=true&w=majority

# ── Autenticação ─────────────────────────────────────────────────
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=30d

# ── Painel de administração (SÓ VOCÊ) ───────────────────────────
# Usada em /admin e nas rotas /api/admin/*. Use algo longo e único.
ADMIN_KEY=escolha_uma_chave_forte_so_sua

# ── E-mail de recuperação de senha (Resend) ─────────────────────
RESEND_API_KEY=
EMAIL_FROM=BelaAgenda <onboarding@resend.dev>

# ── Opcionais ────────────────────────────────────────────────────
WORK_START=7
WORK_END=21
PORT=5000
# RATE_LIMIT_MAX=300        # requisições/min por IP (padrão 300)
# USER_CACHE_TTL_MS=30000   # cache do status do plano (padrão 30s)
